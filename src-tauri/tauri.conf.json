{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelpDesk Ops",
  "version": "0.1.0",
  "identifier": "com.helpdeskops.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HelpDesk Ops",
        "width": 1200,
        "height": 800,
        "decorations": true,
        "transparent": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
